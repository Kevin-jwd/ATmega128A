/* 공통 대기: TWINT 세트 대기 */
// TWI 하드웨어가 동작을 완료하면 TWINT 플래그를 1로 세트. 
// 소프트웨어는 이것을 폴링하며 대기. TWCR에 TWINT=1을 쓰면 클리어됨 (일반 플래그와 반대)
static void twi_wait(void)
{
    while (!(TWCR & (1 << TWINT)));
