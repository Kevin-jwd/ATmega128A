void init_uart0()
{
	// 1. 전송 속도 : 9600bps
	// UBRRnH, UBRRnL (USART Baud Rate Register)
	// H : 상위 4비트, L : 하위 8비트 => 상위 4비트는 사용되지 않음
	UBRR0H = 0x00;
