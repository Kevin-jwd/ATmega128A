	// RXENn (RX Enable) : UART 수신기의 수신 기능 활성화
	// TXENn (TX Enable) : UART 송신기의 송신 기능 활성화
	// RXCIEn (RX Complete Interrupt Enable) : 수신 완료 인터럽트 발생을 허용
	UCSR0B |= 1 << RXEN0 | 1 << TXEN0 | 1 <<  RXCIE0;
