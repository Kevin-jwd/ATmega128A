// UDREn (USART Data Register Empty) : 송신 버퍼가 비어있을 때 1
void UART0_transmit(uint8_t data)
{
	while( !(UCSR0A & (1 << UDRE0)))         // data가 송신 중이면 송신 끝날 때까지 기다림
